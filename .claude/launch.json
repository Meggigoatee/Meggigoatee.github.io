{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "static",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        ".output/public",
        "-l",
        "4300"
      ],
      "port": 4300
    }
  ]
}
